{
  "expo": {
    "name": "Bloom",
    "slug": "bloom",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "./plugins/with-ios-scene-lifecycle",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#232323",
          "image": "./assets/bloom-logo.png",
          "dark": {
            "image": "./assets/bloom-logo.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Bloom uses Bluetooth to connect to your Muse headband and Fitbit heart-rate sensor and display live readings."
        }
      ]
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.bloom",
      "icon": "./assets/bloom.icon",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Bloom connects to the development server on your local network while running a debug build."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.bloom"
    }
  }
}
